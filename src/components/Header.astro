---
import FanMark from './FanMark.astro';
import { SITE } from '../site.config';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Fans and Owners, home">
      <FanMark size={38} />
      <span class="brand-name">Fans and <span>Owners</span></span>
    </a>
    <a class="btn btn--small" href={SITE.petitionUrl} rel="noopener">Sign</a>
  </div>
</header>
