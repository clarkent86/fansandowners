---
/** The Power to the Fan mark: a five-blade fan with a guard ring inside a badge. Original artwork. */
interface Props { size?: number; spin?: boolean; title?: string }
const { size = 40, spin = false, title } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title}>
  <circle cx="32" cy="32" r="29.5" class="fm-face" stroke-width="3" />
  <circle cx="32" cy="32" r="24.5" class="fm-ring" stroke-width="1.6" />
  <g class:list={['fan-blades', { spin }]}>
    <path d="M32 32C29 27 27.5 19 30.5 10.5C35.5 10.5 39.5 15.5 37.5 22.5C36.5 26.5 34.5 29.5 32 32Z" />
    <path d="M32 32C29 27 27.5 19 30.5 10.5C35.5 10.5 39.5 15.5 37.5 22.5C36.5 26.5 34.5 29.5 32 32Z" transform="rotate(72 32 32)" />
    <path d="M32 32C29 27 27.5 19 30.5 10.5C35.5 10.5 39.5 15.5 37.5 22.5C36.5 26.5 34.5 29.5 32 32Z" transform="rotate(144 32 32)" />
    <path d="M32 32C29 27 27.5 19 30.5 10.5C35.5 10.5 39.5 15.5 37.5 22.5C36.5 26.5 34.5 29.5 32 32Z" transform="rotate(216 32 32)" />
    <path d="M32 32C29 27 27.5 19 30.5 10.5C35.5 10.5 39.5 15.5 37.5 22.5C36.5 26.5 34.5 29.5 32 32Z" transform="rotate(288 32 32)" />
  </g>
  <circle cx="32" cy="32" r="4.5" class="fm-face" stroke-width="2.5" />
</svg>
